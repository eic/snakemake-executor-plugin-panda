# The run id comes from --config (forwarded to remote jobs), so the host and
# the PanDA worker compute the same output name. Fall back to "ci" for local
# runs without --config.
RUN = config.get("run", "ci")

# Output goes to the rucio storage provider (default-storage-prefix
# rucio://mock is applied by the CI workflow); the name is a plain filename
# so the resulting DID mock:out-<run>.txt is valid for Rucio's name pattern.
rule all:
    input: f"out-{RUN}.txt"


rule make_hello:
    output: f"out-{RUN}.txt"
    shell:
        "echo 'hello from snakemake-executor-plugin-panda CI' > {output}"
